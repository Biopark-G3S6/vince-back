# Dependências e build
/node_modules
/dist
/build
/tmp
/.temp
/.tmp

# Cobertura e artefatos de teste
/coverage
/.nyc_output
/test-results
/playwright-report

# Variáveis de ambiente — .env.example é versionado
.env*
!.env.example

# Sobrescrita local do Compose
docker-compose.override.yml

# Prisma
/prisma/*.db
/prisma/*.db-journal

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Ferramentas
.eslintcache
/.nest
*.tsbuildinfo

# OpenSpec
# As especificações, mudanças e o arquivo em openspec/ são versionados — são a
# fonte da verdade do que foi acordado. Só o transitório fica de fora.
.openspec-archive.lock

# Claude Code
# Os comandos e skills em .claude/ são gerados pelo OpenSpec e valem para o
# time inteiro; a configuração local de cada um, não.
.claude/settings.local.json
.claude/settings.local.json.backup

# Editores e sistema operacional
.DS_Store
Thumbs.db
.idea
.vscode/*
!.vscode/extensions.json
