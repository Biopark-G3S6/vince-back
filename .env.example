# Copie para .env e ajuste conforme necessário.
# Nenhum valor real de segredo deve ser versionado.

# --- Papel do processo (ADR-0008) ---
# api | worker | relay
ROLE=api
# Lista separada por vírgula. Vazio significa todos os módulos (ADR-0008 §7).
MODULES=

# --- HTTP ---
PORT=3000
# Origens aceitas, separadas por vírgula. Curinga é proibido (ADR-0017 §10).
CORS_ORIGINS=http://localhost:5173

# --- Métricas (ADR-0022 §32: porta distinta da API, não publicada externamente) ---
METRICS_PORT=9464

# --- PostgreSQL (ADR-0018, ADR-0019) ---
DATABASE_URL=postgresql://vince:vince@localhost:5432/vince
# Tamanho do pool por processo. Réplicas x pool deve caber no orçamento (ADR-0019 §9, §10).
DATABASE_POOL_SIZE=10

# --- Redis (ADR-0013, ADR-0020) ---
REDIS_URL=redis://localhost:6379

# --- Sessão (ADR-0013) ---
SESSION_COOKIE_NAME=vince_session
SESSION_IDLE_TTL_SECONDS=28800
SESSION_ABSOLUTE_TTL_SECONDS=604800

# --- Log (ADR-0022) ---
LOG_LEVEL=debug

# --- Derivação de senha (decisão D2 de add-session-authentication) ---
# Argon2id. Calibrar contra a máquina real: o parâmetro de memória é o que mantém alto
# o custo do atacante. Alterá-los NÃO invalida as senhas já derivadas.
PASSWORD_HASH_MEMORY_KIB=19456
PASSWORD_HASH_TIME_COST=2
PASSWORD_HASH_PARALLELISM=1

# --- Proteção anti-CSRF (ADR-0013 §13, §14) ---
# Chave de assinatura do token, mínimo de 32 caracteres. NUNCA versione o valor real.
# Rotacioná-la invalida o token de toda sessão viva; o cliente o reobtém em GET /identity.
CSRF_TOKEN_SECRET=troque-por-um-segredo-aleatorio-de-32-bytes
CSRF_COOKIE_NAME=vince_csrf

# --- Meio de redefinição de senha (RF-ACS-003 RN1) ---
PASSWORD_RESET_TTL_SECONDS=3600
