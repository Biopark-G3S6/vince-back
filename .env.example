# Copie para .env e ajuste conforme necessário.
# Nenhum valor real de segredo deve ser versionado.

# --- Papel do processo (ADR-0008) ---
# api | worker | relay
ROLE=api
# Lista separada por vírgula. Vazio significa todos os módulos (ADR-0008 §7).
MODULES=

# --- HTTP ---
PORT=3000
# Origens aceitas, separadas por vírgula. Curinga é proibido (ADR-0017 §10).
CORS_ORIGINS=http://localhost:5173

# --- Métricas (ADR-0022 §32: porta distinta da API, não publicada externamente) ---
METRICS_PORT=9464

# --- PostgreSQL (ADR-0018, ADR-0019) ---
DATABASE_URL=postgresql://vince:vince@localhost:5432/vince
# Tamanho do pool por processo. Réplicas x pool deve caber no orçamento (ADR-0019 §9, §10).
DATABASE_POOL_SIZE=10

# --- Redis (ADR-0013, ADR-0020) ---
REDIS_URL=redis://localhost:6379

# --- Sessão (ADR-0013) ---
SESSION_COOKIE_NAME=vince_session
SESSION_IDLE_TTL_SECONDS=28800
SESSION_ABSOLUTE_TTL_SECONDS=604800

# --- Log (ADR-0022) ---
LOG_LEVEL=debug
